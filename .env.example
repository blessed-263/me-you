# --- Local dev (copy DATABASE_URL from Railway → Postgres → Connect) ---
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/railway"
# Railway may also expose DATABASE_PRIVATE_URL on the API service — either works.
API_PORT=3001

# --- Vercel (frontend) — set in Vercel project → Environment Variables ---
# Railway API URL, no trailing slash (required for RSVP on production site)
# VITE_API_URL="https://your-service.up.railway.app"

# --- Railway (backend API) — same list as local if you test production frontends ---
# Site origin for RSVP email assets (absolute image URLs)
FRONTEND_URL="https://www.youandmeafrica.com"
# Public site URL for SEO canonicals and Open Graph (Vercel frontend)
# VITE_SITE_URL="https://www.youandmeafrica.com"
# Google Search Console verification token (optional)
# VITE_GOOGLE_SITE_VERIFICATION="your-verification-code"
# Required in production — API refuses to start without this (CORS + RSVP origin checks)
ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,https://youandmeafrica.com,https://www.youandmeafrica.com"

# Redis — shared RSVP rate limits when running multiple API replicas (optional locally)
# REDIS_URL="redis://localhost:6379"
# TODO(FIX): Rate limiting is OFF by default. Set RATE_LIMIT_ENABLED=true to re-enable.
# RATE_LIMIT_ENABLED=false
# RSVP_RATE_LIMIT_MAX=10
# RSVP_RATE_LIMIT_WINDOW_MS=900000
# Or set FRONTEND_URL alone when you have a single production origin:
# FRONTEND_URL="https://www.youandmeafrica.com"
# SERVE
_STATIC=false is set by npm run start:api (API-only; do not set on Vercel)

# --- Resend (RSVP confirmations, admin notify, guest broadcasts) ---
# Create at https://resend.com/api-keys — use same vars on Railway API service
RESEND_API_KEY="re_xxxxxxxx"
RESEND_FROM_EMAIL="You & Me <rsvp@events.youandmeafrica.com>"
RSVP_NOTIFY_EMAIL="you@example.com"
# Test sends: npm run email:send-test:harvest-table | npm run test:email
RSVP_TEST_EMAIL="you@example.com"
# Optional preview name for harvest-table test email
# GUEST_EMAIL_PREVIEW_NAME="Guest"
# Reply-To for personal / day-of guest emails (defaults to tshepo@tshepojeans.co)
# GUEST_EMAIL_REPLY_TO="tshepo@tshepojeans.co"
# MAY_GATHERING_REPLY_TO="tshepo@tshepojeans.co"

# --- AmpEx / Medusa (tickets + organizer) ---
# Production builds default to live AmpEx (mock is opt-in via VITE_USE_MOCK_DATA=true).
# Dev defaults to mock unless VITE_USE_MOCK_DATA=false.
VITE_USE_MOCK_DATA="false"
# VITE_MEDUSA_API_URL="http://localhost:9000"
# VITE_MEDUSA_PUBLISHABLE_KEY="pk_..."
# VITE_MEDUSA_REGION_ID="reg_..."
# VITE_YME_ORGANIZER_ID="org_..."
# Required when VITE_USE_MOCK_DATA=false — AmpEx portal for event create/upload (ampex.store)
# VITE_AMPEX_FRONTEND_URL="https://www.ampex.store"
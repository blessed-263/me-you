{
  "name": "afric-luxe",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npx concurrently -k -n api,vite \"npx tsx watch server/index.ts\" \"npx vite --port=3000 --host=0.0.0.0\"",
    "dev:vite": "npx vite --port=3000 --host=0.0.0.0",
    "build": "npx vite build && npx tsc -p tsconfig.server.json",
    "build:web": "npx tsx scripts/generate-sitemap.ts && npx vite build",
    "build:server": "npx tsc -p tsconfig.server.json",
    "start": "node dist-server/index.js",
    "start:full": "cross-env NODE_ENV=production SERVE_STATIC=true node dist-server/index.js",
    "preview": "npx vite preview",
    "clean": "rm -rf dist",
    "lint": "eslint . && tsc --noEmit",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:email": "npx tsx scripts/test-resend-email.ts",
    "db:migrate": "npx tsx scripts/migrate-db.ts",
    "export:rsvps": "npx tsx scripts/export-rsvps.ts",
    "export:june-rsvps": "npx tsx scripts/export-june-rsvps.ts",
    "export:after-party-tickets": "npx tsx scripts/export-after-party-tickets.ts",
    "export:harvest-table-tickets": "npx tsx scripts/export-harvest-table-tickets.ts",
    "export:tickets": "npm run export:harvest-table-tickets && npm run export:after-party-tickets",
    "email:optimize-hero": "npx tsx scripts/optimize-email-hero.ts",
    "hero:optimize": "npx tsx scripts/optimize-site-hero.ts",
    "email:preview": "npx tsx scripts/preview-may-gathering-email.ts",
    "email:preview:all": "npx tsx scripts/preview-all-emails.ts",
    "email:preview:harvest-table-day-of": "npx tsx scripts/preview-harvest-table-day-of-email.ts",
    "email:preview:after-party-day-of": "npx tsx scripts/preview-after-party-day-of-email.ts",
    "email:send-test:harvest-table": "npx tsx scripts/send-harvest-table-email.ts",
    "email:send-test:harvest-table-day-of": "npx tsx scripts/send-harvest-table-day-of-email.ts",
    "email:send-test:after-party-lunch": "npx tsx scripts/send-after-party-lunch-email.ts",
    "email:send-test:after-party-day-of": "npx tsx scripts/send-after-party-day-of-email.ts"
  },
  "dependencies": {
    "@redis/client": "^6.0.0",
    "@vercel/analytics": "^2.0.1",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pg": "^8.13.1",
    "rate-limit-redis": "^5.0.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.17.0",
    "recharts": "^2.15.4",
    "redis": "^6.0.0",
    "resend": "^6.12.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.55.0",
    "@tailwindcss/vite": "^4.1.14",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^7.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.1.2",
    "eslint": "^10.4.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "sharp": "^0.34.5",
    "supertest": "^7.2.2",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.61.0",
    "vite": "^6.2.3",
    "vitest": "^3.2.4"
  }
}
